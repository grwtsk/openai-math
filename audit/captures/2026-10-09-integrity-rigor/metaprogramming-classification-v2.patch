diff --git a/audit/tools/test_theorem_closure_scan.py b/audit/tools/test_theorem_closure_scan.py
--- a/audit/tools/test_theorem_closure_scan.py
+++ b/audit/tools/test_theorem_closure_scan.py
@@ -1,3 +1,41 @@
+# Add alongside the existing tests.
+
+class MetaprogrammingClassificationTests(unittest.TestCase):
+    def categories(self, source: str) -> set[str]:
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / "M.lean"
+            path.write_text(source, encoding="utf-8")
+            findings, _ = SCAN.scan_source(
+                module="OAI.M",
+                path=path,
+                raw=source,
+                imports=SCAN.parse_imports(source)[0],
+            )
+        return {finding.category for finding in findings}
+
+    def test_tactic_import_is_not_direct_api_use(self) -> None:
+        categories = self.categories("import Lean.Elab.Tactic.Omega\n")
+        self.assertIn("elaboration_tool_import", categories)
+        self.assertNotIn("lean_elab_api", categories)
+
+    def test_direct_api_reference_remains_visible(self) -> None:
+        categories = self.categories(
+            "import Mathlib\n"
+            "def inspect (ctx : Lean.Meta.Context) : Nat := 0\n"
+        )
+        self.assertIn("lean_elab_api", categories)
+
+    def test_run_tac_remains_separate(self) -> None:
+        categories = self.categories(
+            "theorem t : True := by\n  run_tac Lean.Elab.Tactic.closeUsingOrAdmit `True\n"
+        )
+        self.assertIn("run_tac", categories)
+        self.assertIn("lean_elab_api", categories)
