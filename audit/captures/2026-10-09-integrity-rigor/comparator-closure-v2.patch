+++ b/audit/tools/test_comparator_closure_scan.py
@@ -64,6 +64,86 @@ class DeclarationTests(unittest.TestCase):
         self.assertEqual(declarations[0].full_name, "B.t")
+
+    def test_public_theorem_is_detected(self) -> None:
+        source = "namespace OAI\npublic theorem target : True := by trivial\nend OAI\n"
+        declarations = SCAN.parse_declarations(
+            source, module="M", path="M.lean", relevant_short_names={"target"}
+        )
+        self.assertEqual(declarations[0].full_name, "OAI.target")
+        self.assertEqual(declarations[0].visibility, "public")
+
+    def test_private_theorem_remains_marked_inaccessible(self) -> None:
+        source = "namespace OAI\nprivate theorem target : True := by trivial\nend OAI\n"
+        declarations = SCAN.parse_declarations(
+            source, module="M", path="M.lean", relevant_short_names={"target"}
+        )
+        self.assertEqual(declarations[0].visibility, "private")
+
+    def test_mutual_end_does_not_close_namespace(self) -> None:
+        source = """namespace OAI
+mutual
+def helperA : Nat := 0
+def helperB : Nat := helperA
+end
+theorem target : True := by trivial
+end OAI
+"""
+        declarations = SCAN.parse_declarations(
+            source, module="M", path="M.lean", relevant_short_names={"target"}
+        )
+        self.assertEqual(declarations[0].full_name, "OAI.target")
+
+    def test_public_section_end_does_not_close_namespace(self) -> None:
+        source = """namespace OAI
+public section
+def helper : Nat := 0
+end
+theorem target : True := by trivial
+end OAI
+"""
+        declarations = SCAN.parse_declarations(
+            source, module="M", path="M.lean", relevant_short_names={"target"}
+        )
+        self.assertEqual(declarations[0].full_name, "OAI.target")
+
+    def test_root_namespace_resets_enclosing_namespace(self) -> None:
+        source = """namespace OAI
+namespace _root_
+theorem target : True := by trivial
+end _root_
+end OAI
+"""
+        declarations = SCAN.parse_declarations(
+            source, module="M", path="M.lean", relevant_short_names={"target"}
+        )
+        self.assertEqual(declarations[0].full_name, "target")
+
+    def test_guillemet_identifier_dot_is_not_a_namespace_separator(self) -> None:
+        source = "namespace OAI\ntheorem «target.with.dot» : True := by trivial\nend OAI\n"
+        declarations = SCAN.parse_declarations(
+            source,
+            module="M",
+            path="M.lean",
+            relevant_short_names={"«target.with.dot»"},
+        )
+        self.assertEqual(declarations[0].full_name, "OAI.«target.with.dot»")
