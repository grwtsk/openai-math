+def split_axiom_payload(payload: str) -> tuple[list[str] | None, str | None]:
+    """Split Lean's axiom list on commas outside `.{...}` universe syntax."""
+    tokens: list[str] = []
+    current: list[str] = []
+    brace_depth = 0
+
+    for char in payload:
+        if char == "{":
+            brace_depth += 1
+            current.append(char)
+            continue
+        if char == "}":
+            if brace_depth == 0:
+                return None, "unbalanced closing brace in '#print axioms' result"
+            brace_depth -= 1
+            current.append(char)
+            continue
+        if char == "," and brace_depth == 0:
+            token = "".join(current).strip()
+            if not token:
+                return None, "empty axiom token in '#print axioms' result"
+            tokens.append(token)
+            current = []
+            continue
+        current.append(char)
+
+    if brace_depth != 0:
+        return None, "unbalanced opening brace in '#print axioms' result"
+
+    token = "".join(current).strip()
+    if token:
+        tokens.append(token)
+    elif tokens:
+        return None, "empty axiom token in '#print axioms' result"
+    return sorted(set(tokens)), None
+
+
